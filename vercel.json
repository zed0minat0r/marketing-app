{
  "version": 2,
  "buildCommand": "npm install",
  "outputDirectory": ".",
  "functions": {
    "api/sms/inbound.js": {
      "maxDuration": 30
    },
    "api/jobs/[action].js": {
      "maxDuration": 300
    },
    "api/stripe/webhook.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/jobs/dispatch",
      "schedule": "0 14 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/connected",
      "destination": "/connected.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}